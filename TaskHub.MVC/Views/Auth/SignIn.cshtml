@model TaskHub.Application.DTO.User.UserSignInDTO

<div style="display:flex; flex-direction:column; align-items:center; gap:15px; margin-top:50px;">
    <h2>Вхід</h2>

    <form id="signInForm" style="display:flex; flex-direction:column; align-items:center; gap:10px;">

        <input asp-for="Email" placeholder="Email" type="email" style="width:250px;" class="form-control" />
        <span id="EmailError" class="text-danger"></span>

        <input asp-for="Password" placeholder="Пароль" type="password" style="width:250px;" class="form-control" />
        <span id="PasswordError" class="text-danger"></span>

        <span id="GeneralError" class="text-danger"></span>

        <button type="submit" class="btn btn-primary" style="width:250px;">Увійти</button>

        <a asp-action="SignUp" class="text-primary fw-bold" style="align-self:flex-start;">Створити акаунт</a>
    </form>
</div>

<script>
    document.getElementById("signInForm").addEventListener("submit", async function (e) {
        e.preventDefault(); 

        document.getElementById("EmailError").textContent = "";
        document.getElementById("PasswordError").textContent = "";
        document.getElementById("GeneralError").textContent = "";

        const formData = new FormData(this);

        const response = await fetch("/Auth/SignIn", {
            method: "POST",
            body: formData,
            credentials: "same-origin"
        });

        const result = await response.json();

        if (result.success === true) {
            window.location.href = result.redirectUrl;
            return;
        }
        if (result.errors) {
            result.errors.forEach(err => {
                if (err.property === "Email")
                    document.getElementById("EmailError").textContent = err.message;

                else if (err.property === "Password")
                    document.getElementById("PasswordError").textContent = err.message;

                else
                    document.getElementById("GeneralError").textContent = err.message;
            });
        }
    });
</script>
